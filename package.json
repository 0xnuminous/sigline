{
  "name": "sigline",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:python": "uv run pytest",
    "lint:python": "uv run ruff check .",
    "test:contracts": "forge test",
    "fmt:contracts:check": "forge fmt --check",
    "check": "npm run lint:python && npm run test:python && npm run lint && npm run typecheck && npm run build && npm run fmt:contracts:check && npm run test:contracts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openzeppelin/contracts": "5.6.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14"
  },
  "dependencies": {
    "ethers": "^6.16.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "overrides": {
    "ws": "8.20.1"
  }
}
