include LICENSE CHANGES README.rst Makefile config.example
include foundry.toml package.json package-lock.json tsconfig.json vite.config.ts

graft contracts
graft frontend
graft tests
graft docs
prune docs/_build
prune dist
prune node_modules
prune out
prune cache
prune broadcast

global-exclude *.py[cdo] __pycache__ *.so .DS_Store
